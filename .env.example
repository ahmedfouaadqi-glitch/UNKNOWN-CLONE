# Dedicated Supabase project for UNKNOWN only. Never reuse an unrelated database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required server-only HMAC secret. Generate with: openssl rand -hex 32
RATE_LIMIT_SECRET=

# The public website is globally accessible by default.
# User-generated content publishing stays disabled until Supabase persistence
# and applicable regulatory requirements have been verified.
PUBLISHING_ENABLED=false

# Geographic blocklists are empty by default.
# PUBLISHING_BLOCKED_COUNTRIES blocks new submissions only in the listed countries.
# SITE_BLOCKED_COUNTRIES blocks all site paths only where legally required.
PUBLISHING_BLOCKED_COUNTRIES=
SITE_BLOCKED_COUNTRIES=

# Public operator details are maintained in lib/operator.ts.
# Set the production origin after acquiring and configuring the domain.
NEXT_PUBLIC_SITE_URL=https://example.com
